[PROJECT]
application = ppno
name = Optimization of the Hanoi Network (Fujiwara & Khang, 1990)

[INP]
; EPANET .inp model file. Relative paths may be written from the current
; working directory or from this .hnx file location.
HAN.inp

[OPTIONS]
; Optional section. If Algorithm is omitted, PPNO only runs the mandatory
; Unit Headloss heuristic and FLS-H local refinement.
; Available algorithms: DE DA NSGA2 MOEAD MACO PSO
Algorithm NSGA2

[PIPE_CATALOG]
; Pipe catalog file with group, diameter, roughness and price columns.
example_1.cat

[PIPES]
; EPANET pipe ID    pipe-size group
; Each ID must match a pipe/link ID in the EPANET .inp model.
; The pipe-size group selects which catalog entries may be assigned to that pipe.
1    PVC-SDR41
2    PVC-SDR41
3    PVC-SDR41
4    PVC-SDR41
5    PVC-SDR41
6    PVC-SDR41
