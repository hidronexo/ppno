[PROJECT]
application = ppno
name = Optimization of the New York Network (Murphy, Simpson & Dandy, 1993)

[INP]
; EPANET .inp model file. Relative paths may be written from the current
; working directory or from this .hnx file location.
NYT.inp

[OPTIONS]
; Optional section. If Algorithm is omitted, PPNO only runs the mandatory
; Unit Headloss heuristic and FLS-H local refinement.
; Available algorithms: DE DA NSGA2 MOEAD MACO PSO

[PIPE_CATALOG]
; Pipe catalog file with group, diameter, roughness and price columns.
example_2.cat

[PIPES]
; EPANET pipe ID    pipe-size group
; Each ID must match a pipe/link ID in the EPANET .inp model.
; The pipe-size group selects which catalog entries may be assigned to that pipe.
101    NYT
102    NYT
103    NYT
104    NYT
105    NYT
106    NYT
107    NYT
108    NYT
109    NYT
110    NYT
111    NYT
112    NYT
113    NYT
114    NYT
115    NYT
116    NYT
117    NYT
118    NYT
119    NYT
120    NYT
121    NYT

[PRESSURES]
; EPANET node ID    minimum required pressure
; Each ID must match a node ID in the EPANET .inp model.
2    110.546
3    110.546
4    110.546
5    110.546
6    110.546
7    110.546
8    110.546
9    110.546
10    110.546
11    110.546
12    110.546
13    110.546
14    110.546
15    110.546
16    112.714
17    118.263
18    110.546
19    110.546
20    110.546

[END]
